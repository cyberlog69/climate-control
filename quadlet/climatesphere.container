# Podman Quadlet configuration for systemd integration
# Place this file in: ~/.config/containers/systemd/climatesphere.container
# Reload systemd:     systemctl --user daemon-reload
# Start service:      systemctl --user start climatesphere.service
# Enable on boot:     systemctl --user enable climatesphere.service

[Unit]
Description=ClimateSphere Web Sentinel Container
Documentation=https://github.com/cyberlog69/climate-control
After=network-online.target

[Container]
Image=localhost/climate-control:latest
ContainerName=climate-control
PublishPort=8080:8080
AutoUpdate=registry
SecurityLabelDisable=false

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
